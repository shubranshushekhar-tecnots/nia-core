# --- apps/web's own public origin (docs/plans/auth.md) — passed to Better
# Auth as baseURL. Not NEXT_PUBLIC_-prefixed: only read server-side
# (lib/auth/auth.ts), never in the browser bundle. In production
# (docs/plans/web-container.md) this is the single public https origin
# shared with apps/api's WEB_ORIGIN/API_URL. ---
SITE_URL=http://localhost:3100

# --- apps/api (Express), internal/Docker-network address — used two ways:
# (1) Server Components/Actions call this directly with a bearer or cookie
# token (lib/api/server.ts, lib/api/chatServer.ts); (2) next.config.mjs's
# rewrites() uses the same value as the same-origin proxy target for the
# browser's cookie-authenticated chat/run routes (/api/backend/:path* ->
# here). Not NEXT_PUBLIC_-prefixed: read at runtime, never inlined into the
# client bundle. In production this is http://niacore-api:4001 (hardcoded
# in docker-compose.prod.yml, same contract as the connector hostnames —
# see DEPLOYMENT.md). ---
API_INTERNAL_URL=http://localhost:4001

# --- Direct Postgres for @nia/db (docs/plans/data-access.md) and for
# @nia/auth's own Better Auth instance (docs/plans/auth.md) — same
# connection apps/api uses; privilege narrowing per request happens via
# SET LOCAL ROLE inside withActingUser. ---
DATABASE_URL=

# --- Better Auth (docs/plans/auth.md) ---
# Must be byte-identical to apps/api's BETTER_AUTH_SECRET — sessions
# created by either app must verify against the same signing secret.
# Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
