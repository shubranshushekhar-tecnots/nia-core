# --- apps/web's own public origin (docs/plans/auth.md) — passed to Better
# Auth as baseURL; also used to build absolute links. ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- apps/api (Express) ---
# Used two ways: (1) Server Components/Actions call this directly with a
# bearer token (lib/api/server.ts); (2) next.config.mjs's rewrites() uses
# the same value as the same-origin proxy target for the browser's
# cookie-authenticated chat routes (/api/backend/:path* -> here).
NEXT_PUBLIC_API_URL=http://localhost:4001

# --- Direct Postgres for @nia/db (docs/plans/data-access.md) and for
# @nia/auth's own Better Auth instance (docs/plans/auth.md) — same
# connection apps/api uses; privilege narrowing per request happens via
# SET LOCAL ROLE inside withActingUser. ---
DATABASE_URL=

# --- Better Auth (docs/plans/auth.md) ---
# Must be byte-identical to apps/api's BETTER_AUTH_SECRET — sessions
# created by either app must verify against the same signing secret.
# Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
