# LOCAL DEV: every service points at local Supabase (`supabase start`).
# Get URL/ANON_KEY from `supabase status`. Remote (tkairolrvxkphyoijskm) is
# staging/prod only — never point a dev checkout at it, or connections/
# vault secrets created locally won't be visible to it (and vice versa).
# --- Supabase (browser-exposed — anon key only, NEVER the service-role key) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- apps/api (Express) ---
# Used two ways: (1) Server Components/Actions call this directly with a
# bearer token (lib/api/server.ts); (2) next.config.mjs's rewrites() uses
# the same value as the same-origin proxy target for the browser's
# cookie-authenticated chat routes (/api/backend/:path* -> here).
NEXT_PUBLIC_API_URL=http://localhost:4001
