# Full reference of every var apps/web reads at runtime in production
# (docker-compose.prod.yml's niacore-web service). See docs/plans/
# web-container.md and DEPLOYMENT.md.

# --- Direct Postgres for @nia/db (docs/plans/data-access.md) — apps/web has
# its own pool (src/lib/db/pool.ts), same connection apps/api/apps/worker
# use. Must be a direct or session-mode connection, not a transaction-mode
# pooler (see apps/api/.env.production.example's comment for why). ---
DATABASE_URL=                          # SECRET, required

# --- Better Auth (packages/auth) — session-signing secret. Generate with
# `openssl rand -hex 32`. Must be byte-identical to apps/api's copy. ---
BETTER_AUTH_SECRET=                    # SECRET, required

# --- The single public https origin end users hit (docs/plans/
# web-container.md). Better Auth derives its __Secure- cookie prefix from
# this instance's own baseURL scheme — must be byte-identical to apps/api's
# API_URL, or apps/api's session lookup will miss the cookie this service
# issues. ---
SITE_URL=                              # required, e.g. https://app.example.com

# --- Internal, Docker-network address of apps/api — target of this app's
# own /api/backend/* rewrite (next.config.mjs) and the two server-side API
# clients (src/lib/api/server.ts, src/lib/api/chatServer.ts). NOT
# NEXT_PUBLIC_-prefixed: read at runtime, never inlined into the browser
# bundle. docker-compose.prod.yml hardcodes this to http://niacore-api:4001
# directly in niacore-web's environment (a fixed network-alias contract,
# same pattern as the connector hostnames) rather than sourcing it from this
# file — listed here only so a non-Docker or alternate deployment knows what
# to set it to. ---
# API_INTERNAL_URL=http://niacore-api:4001

# --- Optional. Address the paired CLI (apps/agent) should call, shown in
# AddAgentDialog's one-time pairing command (docs/plans/
# agent-canvas-integration.md Slice L3). Unset here deliberately: falls
# back to SITE_URL above, which is correct in this deployment — nginx
# (deploy/nginx/nginx.conf) proxies /agent-api/* on that same public
# origin through to agent-bridge. Only set this if agent-bridge is ever
# exposed on a different public address than SITE_URL. ---
# AGENT_PLATFORM_URL=

PORT=3000                              # optional, default 3000 (niacore-web's container port)

# --- Mail queue producer (src/lib/mail/mailQueue.ts) — enqueues onto the
# same `interactive` BullMQ queue apps/worker consumes. docker-compose.
# prod.yml doesn't set this directly in niacore-web's environment block; it
# arrives via the shared env_file: .env on every niacore-* service (see root
# .env.production.example's REDIS_URL entry) — listed here only so a non-
# Docker or alternate deployment knows what to set it to. ---
# REDIS_URL=redis://niacore-redis:6379
