# Full reference of every var apps/worker/src/env.ts reads. In production
# (docker-compose.prod.yml), only the ones marked "required" below are
# actually wired through by the compose file — everything else relies on
# the app's own default unless you have a real reason to override it. See
# DEPLOYMENT.md.

NODE_ENV=production                    # required in prod (also gates CONNECTOR_DEV_HOST below)

# --- Direct Postgres for @nia/db (docs/plans/data-access.md) — same
# connection apps/api uses; the worker always calls withServiceRole. ---
DATABASE_URL=                          # SECRET, required

# --- Secret storage (docs/plans/secret-storage.md) — must be byte-for-byte
# identical to apps/api's and every connector-*'s copy (see DEPLOYMENT.md).
# Only used by lib/eval/sandbox.ts's golden-eval seeding. ---
NIA_SECRET_MASTER_KEY=                 # SECRET, required

REDIS_URL=redis://redis:6379           # optional, default redis://localhost:6379

# --- Dev-only override for connectorClient.ts. env.ts REFUSES to boot if
# this is set while NODE_ENV=production — never set it here. ---
# CONNECTOR_DEV_HOST=

# --- Write path (Phase 6 Block 2) — shared HMAC secret with every
# connector service; must be identical everywhere it's set. Generate with
# `openssl rand -hex 32`. ---
WRITE_DISPATCH_SIGNING_SECRET=         # SECRET, required, min 32 chars

# --- Nia Gateway (OpenAI-compatible AI gateway) — the chat pipeline's only
# LLM client. Never exposed to apps/web. ---
NIA_GATEWAY_API_KEY=                   # SECRET, required
NIA_GATEWAY_BASE_URL=https://api.nia.naslabs.ai/v1   # optional
NIA_GATEWAY_MODEL=anthropic/claude-sonnet-4-6         # optional
QUERYGEN_MODEL=                        # optional, unset by default (see env.ts comment)
ANSWER_MODEL=                          # optional, unset by default

SCHEMA_CACHE_TTL_MS=300000             # optional

# --- Observability (self-hosted or managed Langfuse). Optional — tracing
# no-ops if unset. ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3005

EVAL_NIGHTLY_CRON=0 3 * * *            # optional
STAGING_SWEEP_CRON=0 * * * *           # optional
CHAT_EVENTS_LOG_TTL_MS=600000          # optional
CHAT_EVENTS_LOG_MAX_LEN=5000           # optional
