{
  "name": "@nia/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build:deps": "pnpm --filter @nia/schemas --filter @nia/guardrails build",
    "presmoke": "pnpm run build:deps",
    "smoke": "tsx scripts/dispatch-smoke.ts",
    "presmoke:aggregate": "pnpm run build:deps",
    "smoke:aggregate": "tsx scripts/aggregate-smoke.ts",
    "presmoke:aggregate:postgres-source": "pnpm run build:deps",
    "smoke:aggregate:postgres-source": "tsx scripts/aggregate-smoke-postgres-source.ts",
    "presmoke:extract:postgres": "pnpm run build:deps",
    "smoke:extract:postgres": "tsx scripts/plain-postgres-extract-smoke.ts",
    "presmoke:write": "docker compose -f ../../docker-compose.yml up -d --build redis dev-postgres connector-supabase",
    "smoke:write": "tsx scripts/write-smoke.ts",
    "presmoke:write:mysql-mongo": "docker compose -f ../../docker-compose.yml up -d --build redis dev-mysql dev-mongo connector-mysql connector-mongodb",
    "smoke:write:mysql-mongo": "tsx scripts/write-smoke-mysql-mongo.ts",
    "presmoke:staged": "docker compose -f ../../docker-compose.yml up -d --build redis dev-mysql dev-postgres connector-mysql connector-supabase",
    "smoke:staged": "tsx scripts/write-smoke-staged.ts",
    "presmoke:destination-contract": "docker compose -f ../../docker-compose.yml up -d --build redis dev-mongo dev-postgres connector-mongodb connector-supabase",
    "smoke:destination-contract": "tsx scripts/destination-contract-smoke.ts",
    "presmoke:contract-clean": "docker compose -f ../../docker-compose.yml up -d --build redis dev-mysql dev-postgres connector-mysql connector-supabase",
    "smoke:contract-clean": "tsx scripts/clean-mysql-postgres-contract-smoke.ts",
    "presmoke:clean": "docker compose -f ../../docker-compose.yml up -d --build redis dev-mysql dev-postgres connector-mysql connector-supabase && pnpm run build:deps",
    "smoke:clean": "tsx scripts/clean-propose-smoke.ts",
    "smoke:chat": "tsx scripts/chat-smoke.ts",
    "smoke:mapping": "tsx scripts/mapping-smoke.ts",
    "presmoke:profile": "pnpm run build:deps",
    "smoke:profile": "tsx scripts/profile-smoke.ts",
    "diagnose:count": "tsx scripts/chat-count-diagnose.ts",
    "bootstrap": "tsx scripts/dev-bootstrap.ts",
    "eval:golden": "tsx scripts/run-golden-eval.ts",
    "eval:golden:plan": "tsx scripts/run-plan-golden-eval.ts",
    "preeval:clean": "pnpm run build:deps",
    "eval:clean": "tsx scripts/run-clean-eval.ts",
    "kill-test": "tsx scripts/kill-test.ts",
    "preconformance:fixtures": "pnpm run build:deps",
    "conformance:fixtures": "tsx scripts/ops-db-conformance.ts",
    "preconformance:agreement": "pnpm run build:deps",
    "conformance:agreement": "tsx scripts/ops-agreement.ts",
    "secrets:rotate": "tsx scripts/secrets-rotate.ts",
    "sweep:staging": "tsx src/cli/stagingSweep.ts"
  },
  "dependencies": {
    "@langchain/core": "^0.3.40",
    "@langchain/langgraph": "^0.2.44",
    "@nia/db": "workspace:*",
    "@nia/guardrails": "workspace:*",
    "@nia/schemas": "workspace:*",
    "@nia/secrets": "workspace:*",
    "@supabase/supabase-js": "^2.46.1",
    "bullmq": "^5.28.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "langfuse": "^3.39.2",
    "openai": "^4.77.0",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "mongodb": "^7.6.0",
    "mysql2": "^3.11.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.0"
  }
}
