# --- Supabase (service_role — see env.ts's header comment for why the
# worker, unlike apps/api, is trusted with it) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Direct Postgres for @nia/db (docs/plans/data-access.md) — same
# connection apps/api uses; the worker always calls withServiceRole. ---
DATABASE_URL=

REDIS_URL=redis://localhost:6379

# --- Dev-only: overrides every connector manifest's Docker-internal host
# when the worker runs on the host instead of inside the compose network.
# Must be unset in production (enforced at boot, see env.ts). ---
CONNECTOR_DEV_HOST=

# --- Nia Gateway (OpenAI-compatible AI gateway) — the chat pipeline's only
# LLM client. Never exposed to apps/web. ---
NIA_GATEWAY_API_KEY=
NIA_GATEWAY_BASE_URL=https://api.nia.naslabs.ai/v1
NIA_GATEWAY_MODEL=anthropic/claude-sonnet-4-6

# Per-call-site overrides (see env.ts's header comment) — both optional,
# fall back to NIA_GATEWAY_MODEL when unset. QUERYGEN_MODEL is currently
# unused: every fast flash tier tried for generateQuery.ts failed the
# quality gate or the speed goal on this gateway account, so it stays
# unset/default like planReduction.ts (see PHASE4_EXIT.md §4 Fix 1).
# ANSWER_MODEL covers buildAnswer.ts/buildAnswerMultiNode.ts.
QUERYGEN_MODEL=
ANSWER_MODEL=

# Introspection cache TTL, ms. See lib/introspection.ts.
SCHEMA_CACHE_TTL_MS=300000

# --- Observability (self-hosted Langfuse, see docker-compose.yml) ---
# Optional: worker runs fine with these unset (tracing is a no-op fallback,
# see lib/observability/langfuse.ts). These exact dev values are
# auto-provisioned by docker-compose.yml's LANGFUSE_INIT_* vars on first
# `docker compose up` — see README's one-time setup step.
LANGFUSE_PUBLIC_KEY=pk-lf-9a67c1df-8846-47fc-a4ec-a7382a36f6c4
LANGFUSE_SECRET_KEY=sk-lf-fbd4b45f-f0fb-47e6-80f7-56a8327e1c0f
LANGFUSE_BASE_URL=http://localhost:3005
