# LOCAL DEV: every service points at local Supabase (`supabase start`).
# Get URL/ANON_KEY from `supabase status`. Remote (tkairolrvxkphyoijskm) is
# staging/prod only.
# --- Supabase (anon key only — Express never holds the service role key;
# see CONVENTIONS.md "Trust boundaries". Per-request clients are built from the
# caller's own access token so RLS keeps enforcing exactly what it did when
# apps/web talked to Postgres directly.) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- CORS: the single origin allowed to call this API ---
WEB_ORIGIN=http://localhost:3100

PORT=4001
