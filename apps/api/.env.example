# LOCAL DEV: every service points at local Supabase (`supabase start`).
# Get URL/ANON_KEY from `supabase status`. Remote (tkairolrvxkphyoijskm) is
# staging/prod only.
# --- Supabase (anon key only — Express never holds the service role key;
# see CONVENTIONS.md "Trust boundaries". Per-request clients are built from the
# caller's own access token so RLS keeps enforcing exactly what it did when
# apps/web talked to Postgres directly.) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Direct Postgres for @nia/db (docs/plans/data-access.md) — replaces
# PostgREST for data access. Connects as the `postgres` role (the only
# role hosted Supabase exposes); privilege narrowing per request happens
# via SET LOCAL ROLE inside withActingUser, not via this connection
# string. See DEPLOYMENT.md's "Database connection pooling" section. ---
DATABASE_URL=

# --- CORS: the single origin allowed to call this API ---
WEB_ORIGIN=http://localhost:3100

# --- Secret storage (docs/plans/secret-storage.md) — envelope-encrypts
# connection/write-grant credentials into nia_secrets. Must be identical
# across apps/api and every connector service (services/connector-*), same
# convention as WRITE_DISPATCH_SIGNING_SECRET below. Generate with:
#   openssl rand -base64 32
# Losing this key makes every stored credential unrecoverable — see
# DEPLOYMENT.md before rotating or regenerating it.
NIA_SECRET_MASTER_KEY=

PORT=4001
