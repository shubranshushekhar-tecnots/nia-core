# --- Direct Postgres for @nia/db (docs/plans/data-access.md) and for
# @nia/auth's Better Auth instance (docs/plans/auth.md). Connects as the
# `postgres` role (the only role hosted Supabase exposes); privilege
# narrowing per request happens via SET LOCAL ROLE inside withActingUser,
# not via this connection string. See DEPLOYMENT.md's "Database connection
# pooling" section. ---
DATABASE_URL=

# --- Better Auth (docs/plans/auth.md) ---
# Public origin of apps/api itself, passed to Better Auth as baseURL.
API_URL=http://localhost:4001
# Must be byte-identical to apps/web's BETTER_AUTH_SECRET. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- CORS: the single origin allowed to call this API ---
WEB_ORIGIN=http://localhost:3100

# --- Secret storage (docs/plans/secret-storage.md) — envelope-encrypts
# connection/write-grant credentials into nia_secrets. Must be identical
# across apps/api and every connector service (services/connector-*), same
# convention as WRITE_DISPATCH_SIGNING_SECRET below. Generate with:
#   openssl rand -base64 32
# Losing this key makes every stored credential unrecoverable — see
# DEPLOYMENT.md before rotating or regenerating it.
NIA_SECRET_MASTER_KEY=

# --- Write-dispatch signing (Phase 6 Block 2, extended Stage 5 to also
# cover this service's own /test, /introspect, /invalidate connector
# dispatches) — shared HMAC secret with apps/worker and every connector
# service. Must be byte-identical everywhere it's set. Generate with:
#   openssl rand -hex 32
WRITE_DISPATCH_SIGNING_SECRET=

PORT=4001
