# Full reference of every var apps/api/src/env.ts reads. In production
# (docker-compose.prod.yml), only the ones marked "required" below are
# actually wired through by the compose file — everything else relies on
# the app's own default unless you have a real reason to override it. See
# DEPLOYMENT.md.

# --- Direct Postgres for @nia/db (docs/plans/data-access.md). This
# service also migrates itself against this connection on container start
# (see docker-entrypoint.sh) — must be a direct/session connection, not a
# transaction pooler (scripts/migrate.mjs refuses port 6543 or a "pooler"
# hostname). Same connection apps/worker uses. ---
DATABASE_URL=                          # SECRET, required

# --- Better Auth (packages/auth) — this service's own base URL (used to
# build callback/redirect URLs) and session-signing secret. Generate the
# secret with `openssl rand -hex 32`. ---
API_URL=                               # required, e.g. https://api.example.com
BETTER_AUTH_SECRET=                    # SECRET, required

# --- CORS: the single origin allowed to call this API ---
WEB_ORIGIN=                            # required, e.g. https://app.example.com

# --- Secret storage (docs/plans/secret-storage.md) — must be identical
# across apps/api and every connector service (services/connector-*). See
# DEPLOYMENT.md before rotating or regenerating it: losing this key makes
# every stored connection/write-grant credential unrecoverable.
NIA_SECRET_MASTER_KEY=                 # SECRET, required

# --- Nia Gateway (OpenAI-compatible AI gateway). Unlike apps/worker, this
# service has no default base URL/model, so both are required here. ---
NIA_GATEWAY_API_KEY=                   # SECRET, required
NIA_GATEWAY_BASE_URL=                  # required, e.g. https://api.nia.naslabs.ai/v1
NIA_GATEWAY_MODEL=                     # required, e.g. anthropic/claude-sonnet-4-6

PORT=4001                              # optional, default 4001
REDIS_URL=redis://niacore-redis:6379   # optional (has an app-side default), but
                                        # docker-compose.prod.yml passes ${REDIS_URL}
                                        # with no compose-side fallback — leaving it
                                        # unset there means an empty string, which
                                        # env.ts's .min(1) rejects at boot

# --- Dev-only. Must stay unset in production — see env.ts's comment. ---
# CONNECTOR_DEV_HOST=

# --- Synchronous-await timeouts on the worker's job queues (ms). All
# optional, sane defaults baked into env.ts; only override if you've
# measured a real need to. ---
CHAT_SSE_MAX_DURATION_MS=120000
CHAT_SSE_HEARTBEAT_MS=15000
CHECK_RUN_TIMEOUT_MS=30000
MAPPING_PROPOSE_TIMEOUT_MS=60000
PLAN_PROPOSE_TIMEOUT_MS=90000
PREVIEW_TIMEOUT_MS=45000
SCHEMA_REFRESH_TIMEOUT_MS=30000
RUN_SSE_MAX_DURATION_MS=1800000
RUN_SSE_HEARTBEAT_MS=15000
PROFILE_TIMEOUT_MS=60000
CLEAN_PROPOSE_TIMEOUT_MS=90000
