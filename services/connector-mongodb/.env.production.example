# Full reference of every var this service reads directly from
# process.env (src/index.ts, src/pool-manager.ts) — it has no zod-
# validated env schema of its own, unlike apps/api/apps/worker.

PORT=4020                              # required (matches the Dockerfile's EXPOSE)

# Vault read-only, via the single resolve_connector_secret RPC — see
# supabase/migrations/0008_connector_secret_rpc.sql. This service never
# touches any other table with this key.
SUPABASE_URL=                          # SECRET, required
SUPABASE_SERVICE_ROLE_KEY=             # SECRET, required

# Shared HMAC secret with apps/worker (signs the write-dispatch context)
# and connector-supabase (re-verifies). Must be identical across all three.
WRITE_DISPATCH_SIGNING_SECRET=         # SECRET, required, min 32 chars

# Upper bound on rows accepted per write-dispatch call.
WRITE_ROW_CAP=5000                     # optional, default 5000
