# Full reference of every var this service reads directly from
# process.env (src/index.ts, src/pool-manager.ts) — it has no zod-
# validated env schema of its own, unlike apps/api/apps/worker.

PORT=4020                              # required (matches the Dockerfile's EXPOSE)

# Direct Postgres connection to the app database — nia_secrets
# (docs/plans/secret-storage.md) plus write_grants lookups, via
# @nia/db's withServiceRole. Same value as apps/api/apps/worker's.
DATABASE_URL=                          # SECRET, required

# Envelope-encryption master key for nia_secrets. Must be identical across
# apps/api and every connector service (services/connector-*), same
# convention as WRITE_DISPATCH_SIGNING_SECRET below. Generate with:
#   openssl rand -base64 32
# Losing this key makes every stored credential unrecoverable — see
# DEPLOYMENT.md before rotating or regenerating it.
NIA_SECRET_MASTER_KEY=                 # SECRET, required

# Shared HMAC secret with apps/worker (signs the write-dispatch context)
# and connector-supabase (re-verifies). Must be identical across all three.
WRITE_DISPATCH_SIGNING_SECRET=         # SECRET, required, min 32 chars

# Upper bound on rows accepted per write-dispatch call.
WRITE_ROW_CAP=5000                     # optional, default 5000
