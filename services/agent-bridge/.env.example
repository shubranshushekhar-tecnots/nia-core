# --- Direct Postgres for @nia/db (docs/plans/data-access.md) — same
# connection apps/api and apps/worker use. ---
DATABASE_URL=

# --- Secret storage (docs/plans/secret-storage.md) — decrypts agent
# connection credentials out of nia_secrets. Must be byte-for-byte
# identical to apps/api's and every connector-*'s copy (see
# DEPLOYMENT.md) — generate with `openssl rand -base64 32`.
NIA_SECRET_MASTER_KEY=

# --- Write-dispatch signing (Phase 6 Block 2) — shared HMAC secret with
# apps/api, apps/worker and every connector service. Must be byte-
# identical everywhere it's set. Generate with `openssl rand -hex 32`.
WRITE_DISPATCH_SIGNING_SECRET=

# Public HTTP API (platform-facing: pairing, agent check-in/tasks).
PORT=4040

# Internal-only HTTP API (apps/api's sole path to the sqlserver_agent
# connector's /test, /introspect, /execute — see src/internalApp.ts's
# header comment). Never published through nginx or docker-compose's
# `ports:`.
INTERNAL_PORT=4041
