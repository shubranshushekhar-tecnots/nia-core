# Full reference of every var this service reads directly from
# process.env (src/app.ts, src/internalApp.ts, src/db.ts,
# src/readAheadCache.ts, src/index.ts) — it has no zod-validated env
# schema of its own, unlike apps/api/apps/worker. See DEPLOYMENT.md.

PORT=4040                              # optional, default 4040 (public /agent-api/* surface)
INTERNAL_PORT=4041                     # optional, default 4041 (internal-only /internal/* surface)

# --- Direct Postgres for @nia/db (docs/plans/data-access.md) — platform_
# agents/agent_tasks/write_grants lookups, via withServiceRole. Same
# connection apps/api, apps/worker, and every connector service use. ---
DATABASE_URL=                          # SECRET, required

# --- Secret storage (docs/plans/secret-storage.md) — must be byte-for-
# byte identical to apps/api's and every connector-*'s copy. Losing this
# key makes every stored connection/write-grant credential unrecoverable
# — see DEPLOYMENT.md before rotating or regenerating it. ---
NIA_SECRET_MASTER_KEY=                 # SECRET, required

# --- Write-dispatch signing — shared HMAC secret with apps/worker and
# every connector service; must be identical across all of them. ---
WRITE_DISPATCH_SIGNING_SECRET=         # SECRET, required, min 32 chars

REDIS_URL=redis://niacore-redis:6379   # optional (has an app-side default), but
                                        # docker-compose.prod.yml passes ${REDIS_URL}
                                        # with no compose-side fallback — leaving it
                                        # unset there means readAheadCache.ts falls
                                        # back to redis://localhost:6379, which does
                                        # not resolve inside the container

# --- How long a long-poll /agent-api/check-in holds open before
# returning an empty task list (ms). Optional, sane default baked in. ---
AGENT_CHECK_IN_HOLD_MS=25000

# --- Phase 6 polish — auto-update (/agent-api/update). Must be
# byte-identical to niacore-web's copy of the same var: both services
# resolve the same manifest.json and installer files from this one
# address. See DEPLOYMENT.md's "Agent downloads" section. ---
# AGENT_DOWNLOADS_BASE_URL=

# --- Dev-only fallback used when AGENT_DOWNLOADS_BASE_URL above is
# unset — points this service at apps/web's own dev-only download route
# instead of serving bytes itself. Never needed in production (the var
# above is required there instead) — leave unset. ---
# AGENT_DOWNLOADS_DEV_WEB_URL=http://localhost:3100
