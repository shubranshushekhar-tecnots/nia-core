# Vars docker-compose.prod.yml itself interpolates (NOT the same as each
# service's own apps/*/.env.production.example / services/*/.env.
# production.example — those are the full per-container runtime reference;
# this file is only what's needed to run `docker compose` at all). Copy to
# .env.production (gitignored) and fill in, then:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d
# See DEPLOYMENT.md.

# --- Image source ---
REGISTRY=                              # required, e.g. ghcr.io/your-org
TAG=                                   # required, e.g. the release git sha or version tag

# --- Direct Postgres for @nia/db (docs/plans/data-access.md) — shared by
# apps/api and apps/worker. apps/api migrates itself against this on
# container start (see apps/api/docker-entrypoint.sh + scripts/migrate.mjs)
# — must be a direct/session connection, not a transaction pooler (port
# 6543 or a "pooler" hostname get refused outright). Percent-encode any
# special characters in the password. ---
DATABASE_URL=                          # SECRET, required

# --- Better Auth (packages/auth) — apps/api's own public URL and
# session-signing secret. Generate the secret with `openssl rand -hex 32`. ---
API_URL=                               # required, e.g. https://api.example.com
BETTER_AUTH_SECRET=                    # SECRET, required

# --- Supabase (hosted project) — Postgres/Auth are no longer used by
# apps/api (see docs/plans/auth.md); these two remain required only
# because apps/worker + all 3 connector services still call the Supabase
# service-role API directly. ---
SUPABASE_URL=                          # SECRET, required (apps/worker + all 3 connectors)
SUPABASE_SERVICE_ROLE_KEY=             # SECRET, required (apps/worker + all 3 connectors)

# --- CORS: the origin apps/api accepts requests from ---
WEB_ORIGIN=                            # required, e.g. https://app.example.com

# --- Secret storage (docs/plans/secret-storage.md) — shared byte-for-byte
# across apps/api, apps/worker, and all 3 connectors. Losing this key makes
# every stored connection/write-grant credential unrecoverable. Generate
# with `openssl rand -base64 32`. ---
NIA_SECRET_MASTER_KEY=                 # SECRET, required

# --- Write path — shared HMAC secret across apps/worker + all 3
# connectors. Generate with `openssl rand -hex 32`. ---
WRITE_DISPATCH_SIGNING_SECRET=         # SECRET, required, min 32 chars

# --- Nia Gateway (AI) — shared by apps/api and apps/worker. apps/api has
# no default base URL/model (unlike apps/worker), so both are required
# here even though only apps/worker strictly needs them overridden. ---
NIA_GATEWAY_API_KEY=                   # SECRET, required
NIA_GATEWAY_BASE_URL=                  # required, e.g. https://api.nia.naslabs.ai/v1
NIA_GATEWAY_MODEL=                     # required, e.g. anthropic/claude-sonnet-4-6

# --- Optional: publish api's port on something other than 4001 ---
# API_PORT=4001
