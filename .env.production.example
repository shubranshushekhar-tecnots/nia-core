# Vars docker-compose.prod.yml itself interpolates (NOT the same as each
# service's own apps/*/.env.production.example / services/*/.env.
# production.example — those are the full per-container runtime reference;
# this file is only what's needed to run `docker compose` at all). Copy to
# `.env` (gitignored) in the same directory as docker-compose.prod.yml,
# fill it in, then:
#   docker compose -f docker-compose.prod.yml up -d
# No --env-file flag needed — Compose reads a file literally named `.env`
# from the project directory automatically.
#
# IMPORTANT: that one `.env` file is read TWICE by Compose — once
# automatically, to substitute every ${VAR} below into docker-compose.
# prod.yml itself, and once per service via that service's own
# `env_file: - .env` entry, which injects the whole file into the
# container's environment. So every variable here is both a compose-
# interpolation input AND a real env var inside every container — there's
# no such thing as a "compose-only" var in this file, and any ${VAR} the
# YAML interpolates must be listed here or the container that also reads
# it via env_file won't see it either. See DEPLOYMENT.md.

# --- Image source: one pre-built, pre-tagged image per service, published
# by .github/workflows/images.yml on every `vX.Y.Z` tag push (see
# DEPLOYMENT.md's "Releasing" section). Pin each var to that same tag,
# including the leading "v". ---
API_IMAGE_VERSION=                     # required, e.g. ghcr.io/your-org/niacore-api:v1.4.0
WEB_IMAGE_VERSION=                     # required, e.g. ghcr.io/your-org/niacore-web:v1.4.0
WORKER_IMAGE_VERSION=                  # required, e.g. ghcr.io/your-org/niacore-worker:v1.4.0
CONNECTOR_MYSQL_IMAGE_VERSION=         # required, e.g. ghcr.io/your-org/niacore-connector-mysql:v1.4.0
CONNECTOR_MONGODB_IMAGE_VERSION=       # required, e.g. ghcr.io/your-org/niacore-connector-mongodb:v1.4.0
CONNECTOR_SUPABASE_IMAGE_VERSION=      # required, e.g. ghcr.io/your-org/niacore-connector-supabase:v1.4.0

# --- Direct Postgres for @nia/db (docs/plans/data-access.md) — shared by
# apps/api, apps/worker, and all 3 connector services (nia_secrets +
# write_grants lookups, via withServiceRole). apps/api migrates itself
# against this on container start (see apps/api/docker-entrypoint.sh +
# scripts/migrate.mjs) — must be a direct/session connection, not a
# transaction pooler (port 6543 or a "pooler" hostname get refused
# outright). Percent-encode any special characters in the password. ---
DATABASE_URL=                          # SECRET, required

# --- Better Auth (packages/auth) — session-signing secret, shared
# byte-identical by apps/api and niacore-web. Generate with
# `openssl rand -hex 32`. ---
BETTER_AUTH_SECRET=                    # SECRET, required

# --- The single public https origin end users hit (docs/plans/
# web-container.md). niacore-proxy (nginx) is the only container that binds
# this origin's port; niacore-api has no public port at all — the browser
# only ever reaches it through niacore-web's own /api/backend/* rewrite
# (apps/web/next.config.mjs), which targets the internal
# http://niacore-api:4001 address hardcoded in docker-compose.prod.yml, not
# a var here. API_URL and WEB_ORIGIN MUST be set to this exact same value:
# Better Auth derives its __Secure- cookie prefix from each instance's own
# baseURL scheme independently, so a mismatch (e.g. one http, one https, or
# different hosts) would make apps/api's session lookup miss the cookie
# apps/web issued. ---
API_URL=                               # required, e.g. https://app.example.com
WEB_ORIGIN=                            # required, same value as API_URL above

# --- Secret storage (docs/plans/secret-storage.md) — shared byte-for-byte
# across apps/api, apps/worker, and all 3 connectors. Losing this key makes
# every stored connection/write-grant credential unrecoverable. Generate
# with `openssl rand -base64 32`. ---
NIA_SECRET_MASTER_KEY=                 # SECRET, required

# --- Write path — shared HMAC secret across apps/worker + all 3
# connectors. Generate with `openssl rand -hex 32`. ---
WRITE_DISPATCH_SIGNING_SECRET=         # SECRET, required, min 32 chars

# --- Nia Gateway (AI) — shared by apps/api and apps/worker. apps/api has
# no default base URL/model (unlike apps/worker), so both are required
# here even though only apps/worker strictly needs them overridden. ---
NIA_GATEWAY_API_KEY=                   # SECRET, required
NIA_GATEWAY_BASE_URL=                  # required, e.g. https://api.nia.naslabs.ai/v1
NIA_GATEWAY_MODEL=                     # required, e.g. anthropic/claude-sonnet-4-6

# --- Redis — both apps/api and apps/worker read this directly (compose no
# longer hardcodes a fallback). Must resolve to the niacore-redis service
# on the compose network: ---
REDIS_URL=redis://niacore-redis:6379   # required

# --- Optional: publish niacore-proxy's port on something other than 80.
# This is the ONLY publicly-reachable port in the whole stack — niacore-api
# and niacore-web no longer publish ports of their own (see the API_URL/
# WEB_ORIGIN comment above). ---
# PROXY_PORT=80
