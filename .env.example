# --- LOCAL DEV: every service points at local Supabase ---
# Run `supabase start`, then `supabase status` for the values below. This is
# a hard rule, not a preference: connections/vault secrets are only visible
# to whichever Supabase project *wrote* them, so if any one app points at
# the remote (tkairolrvxkphyoijskm) project while the rest point local, the
# chat pipeline (and anything else touching connections) breaks silently
# with "not found" errors that look like app bugs. Remote is staging/prod
# ONLY — never point a dev checkout at it.
#   apps/web/.env.local   -> NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY
#   apps/api/.env         -> SUPABASE_URL, SUPABASE_ANON_KEY
#   apps/worker/.env      -> SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY (127.0.0.1, host process)
#   root .env (below)     -> SUPABASE_URL etc, substituted into connector-*
#                            containers by docker-compose.yml — MUST use
#                            host.docker.internal, not 127.0.0.1, since these
#                            values are read from inside the container.

# --- Supabase (app Postgres + Auth + Vault + Storage) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=            # direct Postgres URL for Drizzle migrations

# --- Connector services ---
# Dev-only: apps/api runs on the host (pnpm dev), so manifest.service.host
# ("connector-mysql") isn't reachable — override to reach the port exposed
# in docker-compose.yml. Leave unset in prod (apps/api runs in the network).
CONNECTOR_DEV_HOST=localhost

# --- Write path (Phase 6 Block 2) ---
# Shared HMAC secret between apps/worker (signs) and connector-supabase
# (re-verifies) for the write-dispatch signed context. Must be identical
# in root .env (substituted into the connector-supabase container above)
# and apps/worker/.env. Generate with `openssl rand -hex 32`.
WRITE_DISPATCH_SIGNING_SECRET=

# --- Queue spine ---
REDIS_URL=redis://localhost:6379

# --- AI ---
GEMINI_API_KEY=

# --- Observability (self-hosted Langfuse, see docker-compose.yml) ---
# `docker compose up langfuse-server langfuse-db` auto-provisions a dev
# org/project/user and this exact keypair via LANGFUSE_INIT_* env vars on
# first boot — no manual "Create Project" step. See README's one-time
# setup section. For any non-local deployment, regenerate these (and the
# LANGFUSE_INIT_* values in docker-compose.yml) and never commit real ones.
LANGFUSE_PUBLIC_KEY=pk-lf-9a67c1df-8846-47fc-a4ec-a7382a36f6c4
LANGFUSE_SECRET_KEY=sk-lf-fbd4b45f-f0fb-47e6-80f7-56a8327e1c0f
LANGFUSE_BASE_URL=http://localhost:3005
